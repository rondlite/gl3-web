{
  "name": "gl3-web",
  "version": "0.1.0",
  "private": true,
  "description": "The GL3 website",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:site": "vitepress dev site",
    "dev:server": "tsx watch server/index.ts",
    "build:site": "vitepress build site",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:site && npm run build:server",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "1.14.1",
    "hono": "4.7.7",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@types/node": "22.14.1",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitepress": "1.6.4",
    "vitest": "3.1.2"
  }
}
